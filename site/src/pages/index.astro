---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ProfileSection from '../components/ProfileSection.astro';

const currentYear = new Date().getFullYear();
---

<Layout>
	<a class="skip-link" href="#main-content">Skip to content</a>
	<SiteHeader />

	<main id="main-content">
		<section class="hero page-shell" aria-labelledby="intro-title">
			<div class="hero-copy">
				<p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Personal academic profile</p>
				<h1 id="intro-title">Derya<br /><em>Kucukkarpuz</em></h1>
				<p class="hero-summary">
					A professional profile for academic and teaching opportunities.
				</p>
				<a class="text-link" href="#about">
					Explore profile <span aria-hidden="true">↓</span>
				</a>
			</div>

			<div class="orbit-illustration" aria-hidden="true">
				<div class="orbit orbit-one"></div>
				<div class="orbit orbit-two"></div>
				<div class="moon"></div>
				<span class="orbit-star star-one">✳</span>
				<span class="orbit-star star-two">·</span>
				<span class="orbit-label">FIELD NOTES<br />01 — PROFILE</span>
			</div>

			<div class="hero-index" aria-hidden="true">
				<span>01</span><span class="index-rule"></span><span>03</span>
			</div>
		</section>

		<div class="section-divider page-shell" aria-hidden="true">
			<span>PERSONAL RECORD</span><span>ACADEMIC PROFILE</span><span>EST. IN THE MAKING</span>
		</div>

		<div class="content-grid page-shell">
			<ProfileSection id="about" number="01" eyebrow="Introduction" title="A short introduction">
				<p class="placeholder-copy">
					Add a concise professional bio here: your current role, field, interests, and the
					experience you would like potential employers to know about.
				</p>
			</ProfileSection>

			<ProfileSection id="education" number="02" eyebrow="The record" title="Academic history">
				<p class="placeholder-copy">
					Add your degrees, institutions, fields of study, and any dates you would like to share.
				</p>
				<div class="record-line" aria-hidden="true">
					<span></span><span></span><span></span>
				</div>
			</ProfileSection>

			<ProfileSection id="teaching" number="03" eyebrow="The classroom" title="Teaching">
				<p class="placeholder-copy">
					Add the subjects or courses you teach, your approach to learning, and relevant
					experience.
				</p>
			</ProfileSection>
		</div>

		<section class="contact-band page-shell" aria-labelledby="contact-title">
			<p class="eyebrow">Open channel</p>
			<h2 id="contact-title">Let’s start a conversation.</h2>
			<p>Add a preferred professional email address or contact link here.</p>
		</section>
	</main>

	<footer class="site-footer page-shell">
		<span>Derya Kucukkarpuz</span>
		<span>Personal academic profile <span aria-hidden="true">·</span> {currentYear}</span>
	</footer>
</Layout>

<style>
	:global(:root) {
		--paper: #f6e8ef;
		--paper-deep: #ead5df;
		--ink: #17252e;
		--muted: #4a5a60;
		--accent: #9f542e;
		--accent-soft: #e0c4a7;
		--line: #c9c6ba;
		--display: Georgia, 'Times New Roman', serif;
		--mono: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
		background: var(--paper);
		color: var(--ink);
		scroll-behavior: smooth;
	}

	:global(body) {
		background:
			radial-gradient(ellipse at 78% 9%, rgb(224 191 207 / 50%), transparent 27rem),
			var(--paper);
		color: var(--ink);
		font-family: 'Avenir Next', Avenir, 'Segoe UI', sans-serif;
		margin: 0;
		min-width: 320px;
	}

	:global(body::before) {
		background-image: radial-gradient(#17252e 0.55px, transparent 0.55px);
		background-size: 7px 7px;
		content: '';
		inset: 0;
		opacity: 0.045;
		pointer-events: none;
		position: fixed;
		z-index: 5;
	}

	:global(html[data-contrast='high']) {
		--paper: #fff;
		--paper-deep: #e8e8e8;
		--ink: #000;
		--muted: #292929;
		--accent: #790000;
		--accent-soft: #d6d6d6;
		--line: #555;
		color-scheme: light;
	}

	:global(html[data-contrast='high'] body) {
		background: var(--paper);
	}

	:global(html[data-contrast='high'] body::before) {
		display: none;
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(a) {
		color: inherit;
	}

	:global(a:focus-visible),
	:global(button:focus-visible) {
		outline: 3px solid var(--accent);
		outline-offset: 4px;
	}

	.page-shell {
		margin-inline: auto;
		max-width: 1180px;
		padding-inline: clamp(1.25rem, 6vw, 5.5rem);
	}

	.skip-link {
		background: var(--ink);
		color: var(--paper);
		left: 1rem;
		padding: 0.75rem 1rem;
		position: absolute;
		top: -5rem;
		z-index: 10;
	}

	.skip-link:focus {
		top: 1rem;
	}

	.hero {
		align-items: center;
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		min-height: min(700px, 82vh);
		padding-bottom: 5rem;
		padding-top: 4.5rem;
		position: relative;
	}

	.hero-copy {
		position: relative;
		z-index: 1;
	}

	.eyebrow,
	.section-divider,
	.field-label,
	.hero-index,
	.field-index,
	.site-footer,
	.orbit-label {
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.eyebrow {
		align-items: center;
		color: var(--muted);
		display: flex;
		gap: 0.65rem;
		margin: 0 0 1.5rem;
	}

	.status-dot {
		background: var(--accent);
		border-radius: 50%;
		height: 0.48rem;
		width: 0.48rem;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		font-family: var(--display);
		font-size: clamp(3.7rem, 8.5vw, 7.7rem);
		font-weight: 400;
		letter-spacing: -0.075em;
		line-height: 0.91;
		margin-bottom: 2rem;
	}

	h1 em {
		color: var(--accent);
		font-weight: 400;
	}

	.hero-summary {
		color: var(--muted);
		font-family: var(--display);
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		line-height: 1.5;
		max-width: 24rem;
	}

	.text-link {
		border-bottom: 1px solid var(--accent);
		display: inline-flex;
		font-family: var(--mono);
		font-size: 0.73rem;
		gap: 1rem;
		letter-spacing: 0.08em;
		margin-top: 1.5rem;
		padding-bottom: 0.5rem;
		text-decoration: none;
		text-transform: uppercase;
	}

	.text-link span {
		color: var(--accent);
		font-size: 1rem;
	}

	.orbit-illustration {
		aspect-ratio: 1;
		max-width: 29rem;
		place-self: center end;
		position: relative;
		width: min(100%, 29rem);
	}

	.orbit {
		border: 1px solid var(--line);
		border-radius: 50%;
		inset: 12%;
		position: absolute;
		transform: rotate(-24deg) scaleY(0.48);
	}

	.orbit-two {
		inset: 1%;
		transform: rotate(53deg) scaleY(0.72);
	}

	.moon {
		background:
			radial-gradient(circle at 32% 28%, rgb(255 255 255 / 70%) 0 1px, transparent 2px),
			radial-gradient(circle at 62% 65%, rgb(23 37 46 / 18%) 0 7px, transparent 8px),
			radial-gradient(circle at 45% 54%, rgb(23 37 46 / 12%) 0 4px, transparent 5px),
			linear-gradient(140deg, #d9cbb2, #a8a18e);
		border-radius: 50%;
		box-shadow: 1.5rem 1.7rem 4rem rgb(23 37 46 / 12%);
		height: 39%;
		left: 31%;
		position: absolute;
		top: 28%;
		width: 39%;
	}

	:global(html[data-contrast='high']) .moon {
		background: #d6d6d6;
		border: 2px solid var(--ink);
		box-shadow: none;
	}

	.orbit-star {
		color: var(--accent);
		font-family: var(--display);
		position: absolute;
	}

	.star-one {
		font-size: 1.4rem;
		right: 13%;
		top: 21%;
	}

	.star-two {
		font-size: 2rem;
		left: 14%;
		top: 60%;
	}

	.orbit-label {
		bottom: 9%;
		color: var(--muted);
		line-height: 1.7;
		position: absolute;
		right: 3%;
	}

	.hero-index {
		align-items: center;
		bottom: 2rem;
		color: var(--muted);
		display: flex;
		gap: 0.65rem;
		left: clamp(1.25rem, 6vw, 5.5rem);
		position: absolute;
	}

	.index-rule {
		background: var(--line);
		height: 1px;
		width: 2rem;
	}

	.section-divider {
		border-bottom: 1px solid var(--line);
		border-top: 1px solid var(--line);
		color: var(--muted);
		display: flex;
		justify-content: space-between;
		padding-bottom: 0.85rem;
		padding-top: 0.85rem;
	}

	.content-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		padding-bottom: 6.5rem;
		padding-top: 5.5rem;
	}

	.profile-section {
		border-left: 1px solid var(--line);
		min-height: 17rem;
		padding: 0 1.6rem;
	}

	.profile-section:first-child {
		border-left: 0;
		padding-left: 0;
	}

	.field-index {
		color: var(--accent);
		display: block;
		margin-bottom: 2.5rem;
	}

	.field-label {
		color: var(--muted);
		font-size: 0.62rem;
		margin-bottom: 0.8rem;
	}

	.profile-section h2 {
		font-family: var(--display);
		font-size: clamp(1.55rem, 2.4vw, 2rem);
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 1.15;
		margin-bottom: 1rem;
	}

	.placeholder-copy {
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.7;
		max-width: 22rem;
	}

	.record-line {
		display: flex;
		gap: 0.4rem;
		margin-top: 1.7rem;
	}

	.record-line span {
		background: var(--accent-soft);
		height: 3px;
		width: 2.4rem;
	}

	.record-line span:nth-child(2) {
		width: 1.2rem;
	}

	.contact-band {
		background: var(--paper-deep);
		margin-bottom: 2.5rem;
		padding-bottom: clamp(2.5rem, 6vw, 5rem);
		padding-top: clamp(2.5rem, 6vw, 5rem);
	}

	.contact-band h2 {
		font-family: var(--display);
		font-size: clamp(2rem, 4.8vw, 4.4rem);
		font-weight: 400;
		letter-spacing: -0.055em;
		margin-bottom: 0.85rem;
	}

	.contact-band > p:last-child {
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 0;
	}

	.site-footer {
		color: var(--muted);
		display: flex;
		justify-content: space-between;
		padding-bottom: 2rem;
		padding-top: 0.5rem;
	}

	@media (max-width: 760px) {
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
			padding-bottom: 5rem;
			padding-top: 4rem;
		}

		.orbit-illustration {
			margin: 1.5rem auto 0;
			max-width: 23rem;
			place-self: center;
			width: 76%;
		}

		.hero-index {
			bottom: 1.5rem;
		}

		.section-divider span:last-child {
			display: none;
		}

		.content-grid {
			gap: 2.5rem;
			grid-template-columns: 1fr;
			padding-bottom: 4rem;
			padding-top: 3.5rem;
		}

		.profile-section,
		.profile-section:first-child {
			border-left: 0;
			border-top: 1px solid var(--line);
			min-height: 0;
			padding: 1.4rem 0 0;
		}

		.field-index {
			margin-bottom: 1.3rem;
		}
	}

	@media (max-width: 460px) {
		h1 {
			font-size: clamp(2.8rem, 14vw, 3.5rem);
		}

		.section-divider {
			gap: 1rem;
			justify-content: flex-start;
		}

		.section-divider span:nth-child(2) {
			display: none;
		}

		.site-footer {
			flex-direction: column;
			gap: 0.75rem;
			line-height: 1.6;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html) {
			scroll-behavior: auto;
		}
	}
</style>

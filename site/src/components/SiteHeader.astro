<header class="site-header page-shell">
	<a class="wordmark" href="#main-content" aria-label="Derya Kucukkarpuz, home">
		<span class="wordmark-symbol" aria-hidden="true">DK</span>
		<span>Derya Kucukkarpuz</span>
	</a>

	<nav aria-label="Main navigation">
		<a href="#about">About</a>
		<a href="#education">Academic history</a>
		<a href="#teaching">Teaching</a>
	</nav>

	<button
		class="contrast-toggle"
		type="button"
		aria-pressed="false"
		aria-label="High contrast mode"
	>
		<span class="toggle-indicator" aria-hidden="true"></span>
		<span>Contrast</span>
	</button>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.contrast-toggle');

	if (!toggle) {
		throw new Error('The high-contrast toggle could not be found.');
	}

	toggle.addEventListener('click', () => {
		const enabled = toggle.getAttribute('aria-pressed') !== 'true';
		toggle.setAttribute('aria-pressed', String(enabled));
		document.documentElement.dataset.contrast = enabled ? 'high' : 'standard';
	});
</script>

<style>
	.site-header {
		align-items: center;
		border-bottom: 1px solid var(--line);

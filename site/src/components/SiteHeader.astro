		font-family: var(--mono);
		font-size: 0.58rem;
		height: 2rem;
		justify-content: center;
		letter-spacing: -0.08em;
		width: 2rem;
	}

	nav {
		display: flex;
		gap: clamp(1rem, 2.5vw, 2rem);
		margin-left: auto;
	}

	nav a {
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.65rem;
		letter-spacing: 0.04em;
		text-decoration: none;
	}

	nav a:hover,
	nav a:focus-visible {
		color: var(--accent);
	}

	.contrast-toggle {
		align-items: center;
		background: transparent;
		border: 1px solid var(--line);
		color: var(--ink);
		cursor: pointer;
		display: inline-flex;
		font-family: var(--mono);
		font-size: 0.62rem;
		gap: 0.55rem;
		letter-spacing: 0.04em;
		padding: 0.55rem 0.65rem;
		white-space: nowrap;
	}

	.toggle-indicator {
		border: 1px solid currentColor;
		border-radius: 50%;
		height: 0.65rem;
		width: 0.65rem;
	}

	.contrast-toggle[aria-pressed='true'] {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--paper);
	}

	.contrast-toggle[aria-pressed='true'] .toggle-indicator {
		background: currentColor;
	}

	@media (max-width: 760px) {
		.site-header {
			flex-wrap: wrap;
			gap: 0.9rem 1rem;
			padding-bottom: 0.8rem;
			padding-top: 0.8rem;
		}

		nav {
			order: 3;
			overflow-x: auto;
			padding-bottom: 0.15rem;
			width: 100%;
		}
	}

	@media (max-width: 420px) {
